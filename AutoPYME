<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>AutoPYME · Pimienta IA</title>
  <meta
    name="description"
    content="Probá Pimienta, el agente de IA de AutoPYME que automatiza consultas y presupuestos para PYMEs."
  >

  <style>
    :root {
      --bg: #0b0b0e;
      --surface: #15151a;
      --surface-2: #1d1d24;
      --surface-3: #25252e;

      --primary: #ff5a1f;
      --primary-light: #ff7a45;
      --primary-soft: rgba(255, 90, 31, .12);

      --success: #35d07f;
      --warning: #ffbd4a;
      --danger: #ff5b5b;

      --text: #f7f7f8;
      --muted: #9696a3;
      --border: rgba(255,255,255,.09);

      --radius: 18px;
      --shadow: 0 20px 60px rgba(0,0,0,.35);
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      min-height: 100vh;
      padding: 24px;
      background:
        radial-gradient(
          circle at top,
          rgba(255, 90, 31, .10),
          transparent 38%
        ),
        var(--bg);
      color: var(--text);
      font-family:
        Inter,
        ui-sans-serif,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        sans-serif;
    }

    button,
    textarea {
      font: inherit;
    }

    button {
      -webkit-tap-highlight-color: transparent;
    }

    .app {
      width: min(860px, 100%);
      margin: 0 auto;
    }

    /* HEADER */

    .header {
      text-align: center;
      padding: 24px 0 30px;
    }

    .logo {
      width: 64px;
      height: 64px;
      margin: 0 auto 18px;

      display: grid;
      place-items: center;

      font-size: 32px;

      background:
        linear-gradient(
          145deg,
          rgba(255,122,69,.2),
          rgba(255,90,31,.04)
        );

      border: 1px solid rgba(255,90,31,.3);
      border-radius: 20px;

      box-shadow:
        0 0 40px rgba(255,90,31,.12);
    }

    .header h1 {
      margin: 0;

      font-size: clamp(2rem, 6vw, 3rem);
      line-height: 1.05;
      letter-spacing: -.045em;
    }

    .header h1 span {
      color: var(--primary);
    }

    .header p {
      max-width: 620px;
      margin: 14px auto 0;

      color: var(--muted);
      font-size: 1rem;
      line-height: 1.6;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;

      margin-top: 20px;
      padding: 8px 13px;

      color: #ffb092;
      background: var(--primary-soft);

      border: 1px solid rgba(255,90,31,.25);
      border-radius: 999px;

      font-size: .8rem;
      font-weight: 700;
    }

    .badge::before {
      content: "";
      width: 7px;
      height: 7px;

      background: var(--success);
      border-radius: 50%;

      box-shadow: 0 0 10px var(--success);
    }

    /* CARD */

    .demo-card {
      overflow: hidden;

      background:
        linear-gradient(
          180deg,
          rgba(255,255,255,.025),
          transparent
        ),
        var(--surface);

      border: 1px solid var(--border);
      border-radius: var(--radius);

      box-shadow: var(--shadow);
    }

    .card-header {
      padding: 24px 24px 18px;

      border-bottom: 1px solid var(--border);
    }

    .card-title {
      margin: 0;
      font-size: 1rem;
      font-weight: 700;
    }

    .card-subtitle {
      margin: 6px 0 0;

      color: var(--muted);
      font-size: .85rem;
    }

    .card-body {
      padding: 24px;
    }

    /* PRESETS */

    .presets-title {
      margin-bottom: 10px;

      color: var(--muted);
      font-size: .78rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .06em;
    }

    .presets {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;

      margin-bottom: 18px;
    }

    .preset {
      min-height: 76px;
      padding: 12px;

      text-align: left;

      color: var(--text);
      background: var(--surface-2);

      border: 1px solid var(--border);
      border-radius: 12px;

      cursor: pointer;

      transition:
        transform .2s ease,
        border-color .2s ease,
        background .2s ease;
    }

    .preset:hover {
      transform: translateY(-2px);
      background: var(--surface-3);
      border-color: rgba(255,90,31,.45);
    }

    .preset:focus-visible,
    .main-button:focus-visible,
    .secondary-button:focus-visible,
    .close-button:focus-visible {
      outline: 2px solid var(--primary-light);
      outline-offset: 3px;
    }

    .preset-icon {
      display: block;
      margin-bottom: 6px;
      font-size: 1.1rem;
    }

    .preset strong {
      display: block;
      font-size: .78rem;
    }

    .preset small {
      display: block;
      margin-top: 3px;

      color: var(--muted);
      font-size: .68rem;
    }

    /* INPUT */

    .input-wrapper {
      position: relative;
    }

    textarea {
      width: 100%;
      min-height: 120px;

      padding: 16px 17px 42px;

      color: var(--text);
      background: #0e0e12;

      border: 1px solid var(--border);
      border-radius: 14px;

      resize: vertical;

      outline: none;

      line-height: 1.5;

      transition:
        border-color .2s ease,
        box-shadow .2s ease;
    }

    textarea::placeholder {
      color: #666672;
    }

    textarea:focus {
      border-color: rgba(255,90,31,.65);

      box-shadow:
        0 0 0 4px rgba(255,90,31,.08);
    }

    .char-counter {
      position: absolute;
      right: 13px;
      bottom: 11px;

      color: #60606b;
      font-size: .7rem;
    }

    /* BUTTON */

    .main-button {
      position: relative;

      width: 100%;
      margin-top: 12px;
      padding: 15px 20px;

      color: white;

      background:
        linear-gradient(
          135deg,
          var(--primary),
          #f0440b
        );

      border: 0;
      border-radius: 12px;

      font-weight: 800;
      cursor: pointer;

      box-shadow:
        0 8px 25px rgba(255,90,31,.18);

      transition:
        transform .2s ease,
        box-shadow .2s ease,
        filter .2s ease;
    }

    .main-button:hover {
      transform: translateY(-1px);

      box-shadow:
        0 12px 32px rgba(255,90,31,.25);
    }

    .main-button:active {
      transform: translateY(0);
    }

    .main-button.loading {
      pointer-events: none;
      opacity: .8;
    }

    /* OUTPUT */

    .output {
      margin-top: 18px;
      padding: 20px;

      background: #0e0e12;

      border: 1px solid var(--border);
      border-radius: 14px;

      animation: appear .35s ease;
    }

    @keyframes appear {
      from {
        opacity: 0;
        transform: translateY(8px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .hidden {
      display: none !important;
    }

    /* LOADING */

    .loading {
      padding: 20px 0;
      text-align: center;
    }

    .spinner {
      width: 34px;
      height: 34px;

      margin: 0 auto 14px;

      border: 3px solid rgba(255,255,255,.08);
      border-top-color: var(--primary);

      border-radius: 50%;

      animation: spin .8s linear infinite;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    .loading-text {
      margin: 0;

      color: var(--muted);
      font-size: .82rem;
    }

    /* RESULT */

    .result-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;

      margin-bottom: 18px;
    }

    .agent {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .agent-avatar {
      width: 38px;
      height: 38px;

      display: grid;
      place-items: center;

      background: var(--primary-soft);

      border: 1px solid rgba(255,90,31,.25);
      border-radius: 11px;
    }

    .agent-name {
      font-size: .85rem;
      font-weight: 800;
    }

    .agent-status {
      margin-top: 2px;

      color: var(--success);
      font-size: .68rem;
    }

    .ai-pill {
      padding: 5px 8px;

      color: #ffab8c;
      background: var(--primary-soft);

      border-radius: 7px;

      font-size: .65rem;
      font-weight: 800;
    }

    .quote {
      padding: 16px;

      background: var(--surface);

      border: 1px solid var(--border);
      border-radius: 12px;

      line-height: 1.65;
      font-size: .88rem;
    }

    .quote-items {
      margin: 14px 0;
      padding: 0;

      list-style: none;
    }

    .quote-item {
      display: flex;
      justify-content: space-between;
      gap: 15px;

      padding: 9px 0;

      border-bottom: 1px solid var(--border);

      color: #d9d9df;
    }

    .quote-item:last-child {
      border-bottom: 0;
    }

    .quote-total {
      display: flex;
      justify-content: space-between;

      margin-top: 14px;
      padding-top: 14px;

      border-top: 1px solid var(--border);

      font-size: 1rem;
      font-weight: 800;
    }

    .total-price {
      color: var(--primary-light);
    }

    .success-message {
      margin-top: 14px;
      padding: 10px 12px;

      color: #9de7be;
      background: rgba(53,208,127,.08);

      border: 1px solid rgba(53,208,127,.15);
      border-radius: 9px;

      font-size: .75rem;
    }

    /* COPY */

    .copy-button {
      width: 100%;
      margin-top: 12px;
      padding: 11px;

      color: var(--text);
      background: var(--surface-2);

      border: 1px solid var(--border);
      border-radius: 10px;

      cursor: pointer;

      font-weight: 700;

      transition: .2s ease;
    }

    .copy-button:hover {
      border-color: var(--primary);
      background: var(--primary-soft);
    }

    /* WORKFLOW */

    .workflow {
      margin-top: 20px;
      padding-top: 18px;

      border-top: 1px dashed var(--border);
    }

    .workflow-title {
      margin: 0 0 12px;

      color: var(--muted);

      font-size: .7rem;
      font-weight: 800;
      letter-spacing: .07em;
      text-transform: uppercase;
    }

    .steps {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;

      list-style: none;
      padding: 0;
      margin: 0;
    }

    .step {
      padding: 10px 7px;

      text-align: center;

      color: #666672;
      background: var(--surface-2);

      border: 1px solid transparent;
      border-radius: 8px;

      font-size: .67rem;

      transition: .3s ease;
    }

    .step.active {
      color: var(--text);

      background: var(--primary-soft);

      border-color: rgba(255,90,31,.4);

      box-shadow:
        0 0 20px rgba(255,90,31,.07);
    }

    .step.done {
      color: var(--success);
      border-color: rgba(53,208,127,.2);
      background: rgba(53,208,127,.06);
    }

    /* BOTTOM */

    .bottom-actions {
      margin-top: 16px;
    }

    .secondary-button {
      width: 100%;
      padding: 12px;

      color: var(--primary-light);
      background: transparent;

      border: 1px solid rgba(255,90,31,.4);
      border-radius: 11px;

      font-weight: 800;
      cursor: pointer;

      transition: .2s ease;
    }

    .secondary-button:hover {
      background: var(--primary-soft);
    }

    .disclaimer {
      margin: 15px 0 0;

      color: #5f5f6b;
      text-align: center;

      font-size: .68rem;
      line-height: 1.5;
    }

    /* MODAL */

    .modal {
      position: fixed;
      inset: 0;
      z-index: 1000;

      display: grid;
      place-items: center;

      padding: 20px;

      background: rgba(0,0,0,.78);
      backdrop-filter: blur(8px);
    }

    .modal-content {
      position: relative;

      width: min(620px, 100%);
      max-height: 90vh;
      overflow-y: auto;

      padding: 26px;

      background: var(--surface);

      border: 1px solid var(--border);
      border-radius: 18px;

      box-shadow: var(--shadow);

      animation: modalIn .25s ease;
    }

    @keyframes modalIn {
      from {
        opacity: 0;
        transform: scale(.97) translateY(10px);
      }

      to {
        opacity: 1;
        transform: scale(1) translateY(0);
      }
    }

    .modal-header {
      padding-right: 35px;
    }

    .modal-header h2 {
      margin: 0;
      font-size: 1.25rem;
    }

    .modal-header p {
      margin: 7px 0 0;

      color: var(--muted);
      font-size: .82rem;
      line-height: 1.5;
    }

    .close-button {
      position: absolute;
      top: 15px;
      right: 17px;

      width: 34px;
      height: 34px;

      display: grid;
      place-items: center;

      color: var(--muted);
      background: var(--surface-2);

      border: 0;
      border-radius: 9px;

      cursor: pointer;

      font-size: 20px;
    }

    .ocfe-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;

      margin-top: 20px;
    }

    .ocfe-card {
      padding: 15px;

      background: var(--surface-2);

      border: 1px solid var(--border);
      border-left: 3px solid var(--primary);

      border-radius: 10px;
    }

    .ocfe-card strong {
      font-size: .82rem;
    }

    .ocfe-card p {
      margin: 6px 0 0;

      color: var(--muted);
      font-size: .75rem;
      line-height: 1.5;
    }

    /* MOBILE */

    @media (max-width: 650px) {
      body {
        padding: 12px;
      }

      .header {
        padding: 18px 8px 24px;
      }

      .header h1 {
        font-size: 2rem;
      }

      .card-body {
        padding: 18px;
      }

      .card-header {
        padding: 20px 18px 16px;
      }

      .presets {
        grid-template-columns: 1fr;
      }

      .preset {
        min-height: auto;
      }

      .steps {
        grid-template-columns: repeat(2, 1fr);
      }

      .ocfe-grid {
        grid-template-columns: 1fr;
      }

      .quote-item {
        flex-direction: column;
        gap: 3px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .01ms !important;
        scroll-behavior: auto !important;
      }
    }
  </style>
</head>

<body>

<main class="app">

  <header class="header">

    <div class="logo" aria-hidden="true">
      🌶️
    </div>

    <h1>
      Agente <span>Pimienta</span>
    </h1>

    <p>
      Tu agente de IA para atender consultas, preparar presupuestos
      y registrar pedidos automáticamente, 24/7.
    </p>

    <div class="badge">
      Demo interactiva de AutoPYME
    </div>

  </header>


  <section class="demo-card" aria-labelledby="demo-title">

    <div class="card-header">

      <h2 class="card-title" id="demo-title">
        Probá cómo respondería Pimienta
      </h2>

      <p class="card-subtitle">
        Escribí un pedido real o elegí uno de nuestros escenarios.
      </p>

    </div>


    <div class="card-body">

      <div class="presets-title">
        Escenarios de prueba
      </div>

      <div class="presets">

        <button
          class="preset"
          type="button"
          data-preset="pedido"
        >
          <span class="preset-icon">📦</span>
          <strong>Pedido mayorista</strong>
          <small>Productos + cantidades</small>
        </button>

        <button
          class="preset"
          type="button"
          data-preset="horario"
        >
          <span class="preset-icon">🌙</span>
          <strong>Consulta nocturna</strong>
          <small>Fuera de horario</small>
        </button>

        <button
          class="preset"
          type="button"
          data-preset="ambiguo"
        >
          <span class="preset-icon">❓</span>
          <strong>Consulta informal</strong>
          <small>Jerga + IVA + envío</small>
        </button>

      </div>


      <div class="input-wrapper">

        <textarea
          id="demoInput"
          maxlength="500"
          aria-label="Consulta para Pimienta"
          placeholder="Ej: Hola, necesito 20 cajas de aceite y 10 paquetes de yerba. ¿Me pasás precio mayorista?"
        ></textarea>

        <span
          class="char-counter"
          id="charCounter"
        >
          0/500
        </span>

      </div>


      <button
        class="main-button"
        id="generateButton"
        type="button"
      >
        🌶️ Generar respuesta con Pimienta
      </button>


      <div
        id="demoOutput"
        class="output hidden"
        aria-live="polite"
      >

        <div
          id="loadingState"
          class="loading hidden"
        >

          <div class="spinner"></div>

          <p
            class="loading-text"
            id="loadingText"
          >
            Analizando consulta...
          </p>

        </div>


        <div id="resultContent"></div>


        <button
          id="copyButton"
          class="copy-button hidden"
          type="button"
        >
          📋 Copiar respuesta para WhatsApp
        </button>


        <div
          id="workflow"
          class="workflow hidden"
        >

          <p class="workflow-title">
            Flujo automatizado
          </p>

          <ul class="steps">

            <li class="step" id="step1">
              1. Webhook
            </li>

            <li class="step" id="step2">
              2. IA + OCFE
            </li>

            <li class="step" id="step3">
              3. Catálogo RAG
            </li>

            <li class="step" id="step4">
              4. Google Sheets
            </li>

          </ul>

        </div>

      </div>


      <div class="bottom-actions">

        <button
          class="secondary-button"
          id="ocfeButton"
          type="button"
        >
          🧠 Ver cómo piensa Pimienta
        </button>

        <p class="disclaimer">
          Esta demo simula el flujo de automatización.
          En producción, Pimienta se conecta al catálogo y las herramientas
          reales de cada empresa.
        </p>

      </div>

    </div>

  </section>

</main>


<!-- MODAL -->

<div
  class="modal hidden"
  id="ocfeModal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modalTitle"
>

  <div class="modal-content">

    <button
      class="close-button"
      id="closeModal"
      type="button"
      aria-label="Cerrar"
    >
      ×
    </button>

    <div class="modal-header">

      <h2 id="modalTitle">
        🧠 Cómo piensa Pimienta
      </h2>

      <p>
        La arquitectura OCFE organiza las reglas que utiliza el agente
        para responder de forma consistente y reducir errores.
      </p>

    </div>


    <div class="ocfe-grid">

      <article class="ocfe-card">

        <strong>[O] Objetivos</strong>

        <p>
          Calificar el lead, interpretar el pedido y preparar
          una cotización clara.
        </p>

      </article>


      <article class="ocfe-card">

        <strong>[C] Contexto</strong>

        <p>
          Catálogo, precios, disponibilidad, reglas comerciales
          y tono de comunicación de la empresa.
        </p>

      </article>


      <article class="ocfe-card">

        <strong>[F] Formato</strong>

        <p>
          Respuestas estructuradas con productos, cantidades,
          precios, impuestos y próximos pasos.
        </p>

      </article>


      <article class="ocfe-card">

        <strong>[E] Excepciones</strong>

        <p>
          Si un dato no existe o no hay stock, el agente no lo inventa:
          deriva el caso a una persona.
        </p>

      </article>

    </div>

  </div>

</div>


<script>

  /* =========================
     CONFIGURACIÓN
  ========================= */

  const presets = {

    pedido: {
      text:
        "Hola! Necesito presupuesto por 15 cajas de aceite de girasol y 8 kg de yerba mate para enviar a Rosario.",
      type: "pedido"
    },

    horario: {
      text:
        "Buenas noches! ¿Tienen fardos de harina disponibles para entregar mañana a primera hora?",
      type: "horario"
    },

    ambiguo: {
      text:
        "Che, ¿cuánto me saldrían 20 packs de yerba con IVA y envío?",
      type: "ambiguo"
    }

  };


  /* =========================
     ELEMENTOS
  ========================= */

  const input = document.getElementById("demoInput");
  const counter = document.getElementById("charCounter");

  const generateButton =
    document.getElementById("generateButton");

  const output =
    document.getElementById("demoOutput");

  const loading =
    document.getElementById("loadingState");

  const loadingText =
    document.getElementById("loadingText");

  const result =
    document.getElementById("resultContent");

  const copyButton =
    document.getElementById("copyButton");

  const workflow =
    document.getElementById("workflow");

  const modal =
    document.getElementById("ocfeModal");

  const ocfeButton =
    document.getElementById("ocfeButton");

  const closeModal =
    document.getElementById("closeModal");


  /* =========================
     CONTADOR
  ========================= */

  input.addEventListener("input", () => {

    counter.textContent =
      `${input.value.length}/500`;

  });


  /* =========================
     PRESETS
  ========================= */

  document.querySelectorAll("[data-preset]")
    .forEach(button => {

      button.addEventListener("click", () => {

        const preset =
          presets[button.dataset.preset];

        input.value = preset.text;

        counter.textContent =
          `${input.value.length}/500`;

        generarPresupuesto(preset.type);

      });

    });


  /* =========================
     GENERAR
  ========================= */

  generateButton.addEventListener(
    "click",
    () => generarPresupuesto()
  );


  async function generarPresupuesto(type = null) {

    const text =
      input.value.trim();

    if (!text) {

      input.focus();

      mostrarError(
        "Escribí una consulta antes de generar la respuesta."
      );

      return;
    }


    output.classList.remove("hidden");

    loading.classList.remove("hidden");

    result.innerHTML = "";

    copyButton.classList.add("hidden");

    workflow.classList.add("hidden");

    generateButton.classList.add("loading");

    generateButton.textContent =
      "🌶️ Pimienta está pensando...";


    const messages = [
      "Analizando consulta...",
      "Consultando catálogo...",
      "Aplicando reglas comerciales...",
      "Preparando respuesta..."
    ];


    for (const message of messages) {

      loadingText.textContent = message;

      await esperar(450);

    }


    loading.classList.add("hidden");

    generateButton.classList.remove("loading");

    generateButton.textContent =
      "🌶️ Generar respuesta con Pimienta";


    const response =
      generarRespuesta(text, type);

    result.innerHTML = response;

    copyButton.classList.remove("hidden");

    workflow.classList.remove("hidden");

    animarWorkflow();

  }


  /* =========================
     RESPUESTAS DEMO
  ========================= */

  function generarRespuesta(text, type) {

    const normalized =
      text.toLowerCase();


    if (
      type === "horario" ||
      normalized.includes("buenas noches") ||
      normalized.includes("23")
    ) {

      return `
        <div class="result-header">

          <div class="agent">

            <div class="agent-avatar">
              🌶️
            </div>

            <div>
              <div class="agent-name">
                Pimienta
              </div>

              <div class="agent-status">
                ● Catálogo consultado
              </div>
            </div>

          </div>

          <span class="ai-pill">
            IA
          </span>

        </div>

        <div class="quote">

          <strong>¡Buenas noches!</strong>

          <p>
            Sí, tenemos disponibilidad de harina para entrega
            mañana. Como es fuera del horario comercial, puedo
            registrar el pedido y dejarlo listo para que el equipo
            lo confirme a primera hora.
          </p>

          <div class="success-message">
            ✓ Consulta registrada automáticamente
          </div>

        </div>
      `;

    }


    if (
      type === "ambiguo" ||
      normalized.includes("packs") ||
      normalized.includes("yerba")
    ) {

      const subtotal = 54950;
      const iva = subtotal * 0.21;
      const total = subtotal + iva;

      return crearCotizacion({
        greeting:
          "¡Dale! Te preparo el presupuesto con IVA incluido.",
        items: [
          ["20 × Pack de Yerba Mate 1kg", 54950]
        ],
        subtotal,
        iva,
        total
      });

    }


    return crearCotizacion({
      greeting:
        "¡Hola! Te paso el presupuesto solicitado:",
      items: [
        ["15 × Aceite de Girasol 900ml", 27750],
        ["8 × Yerba Mate 1kg", 27200]
      ],
      subtotal: 54950,
      iva: 54950 * 0.21,
      total: 54950 * 1.21
    });

  }


  function crearCotizacion({
    greeting,
    items,
    subtotal,
    iva,
    total
  }) {

    return `
      <div class="result-header">

        <div class="agent">

          <div class="agent-avatar">
            🌶️
          </div>

          <div>

            <div class="agent-name">
              Pimienta
            </div>

            <div class="agent-status">
              ● Respuesta generada
            </div>

          </div>

        </div>

        <span class="ai-pill">
          IA
        </span>

      </div>


      <div class="quote">

        <strong>${greeting}</strong>


        <ul class="quote-items">

          ${items.map(([name, price]) => `
            <li class="quote-item">
              <span>${name}</span>
              <strong>
                $${formatear(price)}
              </strong>
            </li>
          `).join("")}

        </ul>


        <div class="quote-item">
          <span>Subtotal</span>
          <span>$${formatear(subtotal)}</span>
        </div>


        <div class="quote-item">
          <span>IVA 21%</span>
          <span>$${formatear(iva)}</span>
        </div>


        <div class="quote-total">

          <span>
            Total final
          </span>

          <span class="total-price">
            $${formatear(total)}
          </span>

        </div>


        <div class="success-message">
          ✓ Presupuesto listo para registrar en Google Sheets
        </div>

      </div>
    `;

  }


  /* =========================
     WORKFLOW
  ========================= */

  function animarWorkflow() {

    const steps = [
      document.getElementById("step1"),
      document.getElementById("step2"),
      document.getElementById("step3"),
      document.getElementById("step4")
    ];


    steps.forEach(step => {

      step.classList.remove("active", "done");

    });


    steps.forEach((step, index) => {

      setTimeout(() => {

        step.classList.add("active");

      }, index * 350);


      setTimeout(() => {

        step.classList.remove("active");

        step.classList.add("done");

      }, index * 350 + 300);

    });

  }


  /* =========================
     COPIAR
  ========================= */

  copyButton.addEventListener(
    "click",
    async () => {

      const text =
        result.innerText.trim();

      try {

        await navigator.clipboard.writeText(text);

        copyButton.textContent =
          "✅ Copiado para WhatsApp";

        setTimeout(() => {

          copyButton.textContent =
            "📋 Copiar respuesta para WhatsApp";

        }, 2200);

      } catch {

        mostrarError(
          "No pudimos copiar automáticamente. Seleccioná el texto manualmente."
        );

      }

    }
  );


  /* =========================
     MODAL
  ========================= */

  ocfeButton.addEventListener(
    "click",
    abrirModal
  );

  closeModal.addEventListener(
    "click",
    cerrarModal
  );


  modal.addEventListener(
    "click",
    event => {

      if (event.target === modal) {
        cerrarModal();
      }

    }
  );


  document.addEventListener(
    "keydown",
    event => {

      if (
        event.key === "Escape" &&
        !modal.classList.contains("hidden")
      ) {

        cerrarModal();

      }

    }
  );


  function abrirModal() {

    modal.classList.remove("hidden");

    closeModal.focus();

  }


  function cerrarModal() {

    modal.classList.add("hidden");

    ocfeButton.focus();

  }


  /* =========================
     UTILIDADES
  ========================= */

  function esperar(ms) {

    return new Promise(
      resolve => setTimeout(resolve, ms)
    );

  }


  function formatear(numero) {

    return new Intl.NumberFormat(
      "es-AR",
      {
        maximumFractionDigits: 2
      }
    ).format(numero);

  }


  function mostrarError(message) {

    output.classList.remove("hidden");

    loading.classList.add("hidden");

    workflow.classList.add("hidden");

    copyButton.classList.add("hidden");

    result.innerHTML = `
      <div
        style="
          padding:12px;
          color:#ff9b9b;
          background:rgba(255,91,91,.08);
          border:1px solid rgba(255,91,91,.15);
          border-radius:9px;
          font-size:.8rem;
        "
      >
        ⚠️ ${message}
      </div>
    `;

  }

</script>

</body>
</html>
