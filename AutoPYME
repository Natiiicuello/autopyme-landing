<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ccircle cx='50' cy='50' r='46' fill='%2308060D'/%3E%3Ccircle cx='50' cy='50' r='46' fill='none' stroke='%23c77dff' stroke-width='4'/%3E%3Ctext x='50' y='66' font-size='56' text-anchor='middle' fill='%23c77dff'%3EP%3C/text%3E%3C/svg%3E">
