<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --ink: #08060D;
    --ink-2: #100C1B;
    --ink-3: #181129;
    --violet: #9d4edf;
    --violet-bright: #c77dff;
    --violet-soft: #e0aaff;
    --mint: #b5179e;
    --text: #F3EEFE;
    --text-muted: #9D8ec4;
    --line: rgba(157, 78, 223, 0.18);
    --radius: 14px;
    --serif: 'Fraunces', serif;
    --sans: 'Inter', sans-serif;
    --mono: 'IBM Plex Mono', monospace;
  }

  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--ink);
    color:var(--text);
    font-family:var(--sans);
    line-height:1.5;
    overflow-x:hidden;
  }
  a{color:inherit; text-decoration:none;}
  img,svg{display:block; max-width:100%;}
  section{position:relative; padding:120px 24px;}
  .wrap{max-width:1120px; margin:0 auto;}
  .eyebrow{
    font-family:var(--mono);
    font-size:12.5px;
    letter-spacing:.14em;
    text-transform:uppercase;
    color:var(--violet-bright);
    display:flex;
    align-items:center;
    gap:10px;
    margin-bottom:18px;
  }
  .eyebrow::before{
    content:'';
    width:7px; height:7px; border-radius:50%;
    background:var(--violet-bright);
    box-shadow:0 0 10px var(--violet-bright);
  }
  h1,h2,h3{font-family:var(--serif); font-weight:600; letter-spacing:-0.01em;}
  h2{font-size:clamp(30px,4vw,44px); line-height:1.12;}
  p{color:var(--text-muted);}
  .lede{font-size:18px; max-width:620px;}

  /* ===== NAV ===== */
  nav{
    position:fixed; top:0; left:0; right:0; z-index:100;
    padding:20px 24px;
    background:rgba(8, 6, 13, 0.85);
    backdrop-filter:blur(14px);
    border-bottom:1px solid var(--line);
  }
  nav .wrap{display:flex; align-items:center; justify-content:space-between;}
  .logo{
    font-family:var(--serif); font-weight:700; font-size:21px;
    display:flex; align-items:center; gap:9px;
    letter-spacing:-0.01em;
  }
  .logo .dot{width:8px;height:8px;border-radius:50%;background:var(--violet-bright); box-shadow:0 0 12px var(--violet-bright);}
  nav ul{display:flex; gap:34px; list-style:none;}
  nav ul a{font-size:14.5px; color:var(--text-muted); transition:color .2s;}
  nav ul a:hover{color:var(--text);}
  .nav-cta{
    font-family:var(--mono); font-size:13px;
    border:1px solid var(--line); padding:9px 18px; border-radius:100px;
    color:var(--text); transition:all .2s;
    background: rgba(157, 78, 223, 0.08);
  }
  .nav-cta:hover{border-color:var(--violet-bright); color:var(--violet-bright); box-shadow:0 0 15px rgba(199, 125, 255, 0.3);}

  /* ===== BOTÓN FLOTANTE ===== */
  .fab{
    position:fixed; bottom:26px; right:26px; z-index:80;
    width:60px; height:60px; border-radius:50%;
    background:linear-gradient(135deg, var(--violet), #7b2fb5);
    display:flex; align-items:center; justify-content:center;
    font-size:26px; text-decoration:none; color:#fff;
    box-shadow:0 10px 30px rgba(157,78,223,.45);
    animation:fabPulse 2.6s infinite;
    transition:transform .2s;
  }
  .fab:hover{transform:scale(1.08);}
  @keyframes fabPulse{
    0%{box-shadow:0 10px 30px rgba(157,78,223,.45), 0 0 0 0 rgba(157,78,223,.45);}
    70%{box-shadow:0 10px 30px rgba(157,78,223,.45), 0 0 0 14px rgba(157,78,223,0);}
    100%{box-shadow:0 10px 30px rgba(157,78,223,.45), 0 0 0 0 rgba(157,78,223,0);}
  }
  @media(prefers-reduced-motion: reduce){ .fab{animation:none;} }
  @media(max-width:600px){ .fab{width:52px; height:52px; font-size:21px; bottom:18px; right:18px;} }
  .nav-burger{
    display:none;
    background:none; border:1px solid var(--line); border-radius:8px;
    width:40px; height:40px;
    align-items:center; justify-content:center;
    cursor:pointer; flex-direction:column; gap:5px;
  }
  .nav-burger span{display:block; width:18px; height:2px; background:var(--text); transition:transform .2s, opacity .2s;}
  .nav-burger[aria-expanded="true"] span:nth-child(1){transform:translateY(7px) rotate(45deg);}
  .nav-burger[aria-expanded="true"] span:nth-child(2){opacity:0;}
  .nav-burger[aria-expanded="true"] span:nth-child(3){transform:translateY(-7px) rotate(-45deg);}
  @media(max-width:820px){
    .nav-burger{display:flex;}
    nav ul{
      display:flex; flex-direction:column; gap:0;
      position:fixed; top:73px; left:0; right:0;
      background:var(--ink-2);
      border-bottom:1px solid var(--line);
      max-height:0; overflow:hidden;
      transition:max-height .25s ease;
    }
    nav.menu-open ul{max-height:420px;}
    nav ul li{width:100%;}
    nav ul a{display:block; padding:16px 24px; border-top:1px solid var(--line); font-size:15.5px;}
    .nav-cta{display:none;}
  }

  /* ===== HERO ===== */
  .hero{
    padding-top:180px;
    min-height:88vh;
  }
  .hero::before{
    content:'';
    position:absolute; inset:0;
    background:
      radial-gradient(700px 500px at 85% 10%, rgba(157, 78, 223, 0.25), transparent 70%),
      radial-gradient(600px 450px at 5% 85%, rgba(181, 23, 158, 0.15), transparent 70%);
    pointer-events:none;
  }
  .hero h1{
    font-size:clamp(38px,5.4vw,64px);
    line-height:1.05;
    margin-bottom:22px;
  }
  .hero h1 em{
    font-style:italic; color:var(--violet-soft); font-weight:500;
    text-shadow: 0 0 20px rgba(224, 170, 255, 0.3);
  }
  .hero .lede{margin-bottom:34px; font-size:17.5px;}
  .hero-actions{display:flex; gap:14px; flex-wrap:wrap; margin-bottom:40px;}
  .btn{
    font-family:var(--sans); font-weight:600; font-size:15px;
    padding:14px 26px; border-radius:10px;
    display:inline-flex; align-items:center; gap:8px;
    transition:all .2s;
  }
  .btn-primary{
    background:linear-gradient(135deg, var(--violet) 0%, var(--mint) 100%);
    color:#ffffff;
    box-shadow: 0 4px 20px rgba(157, 78, 223, 0.4);
  }
  .btn-primary:hover{
    transform:translateY(-2px);
    box-shadow: 0 6px 25px rgba(199, 125, 255, 0.6);
  }
  .btn-ghost{border:1px solid var(--line); color:var(--text); background: rgba(16, 12, 27, 0.6);}
  .btn-ghost:hover{border-color:var(--violet-bright); background: rgba(157, 78, 223, 0.15);}

  .trust-row{display:flex; gap:28px; flex-wrap:wrap;}
  .trust-row .num{font-family:var(--serif); font-size:26px; color:var(--text); display:block;}
  .trust-row .lbl{font-size:12.5px; color:var(--text-muted); font-family:var(--mono);}

  /* Live ops panel */
  .panel{
    background:linear-gradient(180deg, var(--ink-2), var(--ink-3));
    border:1px solid var(--line);
    border-radius:18px;
    overflow:hidden;
    box-shadow:0 20px 50px rgba(0, 0, 0, 0.8), 0 0 30px rgba(157, 78, 223, 0.15);
  }
  .panel-head{
    display:flex; align-items:center; justify-content:space-between;
    padding:16px 20px;
    border-bottom:1px solid var(--line);
    font-family:var(--mono); font-size:12px; color:var(--text-muted);
  }
  .panel-head .live{color:var(--violet-soft); display:flex; align-items:center; gap:7px;}
  .panel-head .live::before{content:''; width:6px; height:6px; border-radius:50%; background:var(--violet-bright); box-shadow:0 0 8px var(--violet-bright); animation:pulse 1.6s infinite;}
  @keyframes pulse{0%,100%{opacity:1;}50%{opacity:.3;}}
  .ticker{
    height:380px; overflow:hidden; position:relative;
    mask-image:linear-gradient(to bottom, transparent, black 8%, black 90%, transparent);
  }
  .ticker-track{
    display:flex; flex-direction:column;
    animation:scrollUp 22s linear infinite;
  }
  @keyframes scrollUp{
    from{transform:translateY(0);}
    to{transform:translateY(-50%);}
  }
  .tick{
    display:flex; gap:14px; padding:13px 20px;
    border-bottom:1px solid var(--line);
    font-family:var(--mono); font-size:12.5px;
  }
  .tick .t{color:var(--text-muted); flex-shrink:0; width:52px;}
  .tick .badge{
    flex-shrink:0; font-size:10px; padding:2px 7px; border-radius:5px; height:fit-content;
    text-transform:uppercase; letter-spacing:.06em;
  }
  .badge.ok{background:rgba(181, 23, 158, 0.25); color:var(--violet-soft); border: 1px solid rgba(181, 23, 158, 0.4);}
  .badge.new{background:rgba(157, 78, 223, 0.25); color:var(--violet-bright); border: 1px solid rgba(157, 78, 223, 0.4);}
  .tick .msg{color:var(--text);}
  .panel-foot{
    padding:14px 20px; border-top:1px solid var(--line);
    display:flex; justify-content:space-between; font-family:var(--mono); font-size:11.5px; color:var(--text-muted);
  }

  @media(max-width:900px){
    .hero{padding-top:150px;}
  }

  /* ===== HERO MOCKUP (chat Pimienta) ===== */
  .hero-mockup{
    position:relative;
    background:linear-gradient(160deg, var(--ink-2), var(--ink-3));
    border:1px solid var(--line);
    border-radius:20px;
    padding:20px;
    box-shadow:0 30px 70px rgba(0,0,0,.45), 0 0 40px rgba(157,78,223,.08);
  }
  .hero-mockup-head{
    display:flex; align-items:center; gap:10px;
    padding-bottom:14px; margin-bottom:14px;
    border-bottom:1px solid var(--line);
  }
  .hero-mockup-avatar{
    width:34px; height:34px; border-radius:50%;
    background:linear-gradient(135deg, var(--violet), var(--mint));
    display:flex; align-items:center; justify-content:center;
    font-size:16px;
  }
  .hero-mockup-name{font-family:var(--serif); font-size:15px; font-weight:600;}
  .hero-mockup-status{font-family:var(--mono); font-size:11px; color:#7ee787; display:flex; align-items:center; gap:5px;}
  .hero-mockup-status::before{content:''; width:6px; height:6px; border-radius:50%; background:#7ee787; box-shadow:0 0 8px #7ee787;}
  .chat-bubble{
    max-width:82%;
    padding:10px 14px;
    border-radius:14px;
    font-size:13.5px;
    line-height:1.4;
    margin-bottom:10px;
    animation:bubbleIn .5s ease both;
  }
  .chat-bubble.in{
    background:linear-gradient(135deg, var(--violet), #7b2fb5);
    color:#fff;
    border-bottom-left-radius:4px;
  }
  .chat-bubble.out{
    background:var(--ink-3);
    border:1px solid var(--line);
    color:var(--text);
    margin-left:auto;
    border-bottom-right-radius:4px;
  }
  .chat-bubble.in + .chat-bubble.in{margin-top:-4px;}
  .chat-bubble .t{display:block; font-family:var(--mono); font-size:10px; opacity:.55; margin-top:4px;}
  @keyframes bubbleIn{ from{opacity:0; transform:translateY(8px);} to{opacity:1; transform:translateY(0);} }
  @media(prefers-reduced-motion: reduce){ .chat-bubble{animation:none;} }
  @media(max-width:900px){ .hero-mockup{max-width:420px; margin:0 auto;} }

  /* ===== SECTION HEAD ===== */
  .sec-head{max-width:640px; margin-bottom:56px;}

  /* ===== SECCIÓN PIMIENTA ===== */
  .pimienta-card {
    background: linear-gradient(135deg, var(--ink-2) 0%, var(--ink-3) 100%);
    border: 1px solid var(--violet);
    border-radius: 20px;
    padding: 40px;
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 30px;
    align-items: center;
    margin-bottom: 80px;
    box-shadow: 0 10px 40px rgba(157, 78, 223, 0.25);
  }
  .pimienta-avatar {
    width: 100px;
    height: 100px;
    background: rgba(157, 78, 223, 0.15);
    border: 2px solid var(--violet-bright);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 48px;
    box-shadow: 0 0 25px rgba(157, 78, 223, 0.4);
  }
  .pimienta-info h3 {
    font-size: 26px;
    margin-bottom: 8px;
    color: var(--text);
  }
  .pimienta-info p {
    font-size: 15px;
    color: var(--text-muted);
    margin-bottom: 16px;
  }
  .pimienta-tags {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  @media(max-width:650px){
    .pimienta-card { grid-template-columns: 1fr; text-align: center; justify-items: center; }
  }

  /* ===== PAIN GRID ===== */
  .pain-list{display:flex; flex-direction:column; gap:14px;}
  .pain-row{
    display:flex; align-items:center; gap:18px;
    background:var(--ink-3); border:1px solid var(--line); border-radius:14px;
    padding:22px 26px; transition:border-color .2s;
  }
  .pain-row:hover{border-color:rgba(224,90,90,.4);}
  .pain-row .warn-ico{
    width:38px; height:38px; border-radius:50%; flex-shrink:0;
    background:rgba(224,90,90,.15); border:1px solid rgba(224,90,90,.35);
    display:flex; align-items:center; justify-content:center; font-size:16px;
  }
  .pain-row p{color:var(--text); font-size:15.5px; margin:0; line-height:1.5;}
  @media(max-width:600px){ .pain-row{padding:16px 18px; gap:14px;} .pain-row p{font-size:14px;} }

  /* ===== SERVICES ===== */
  .services{background:var(--ink-2); border-top:1px solid var(--line); border-bottom:1px solid var(--line);}
  .service-list{display:flex; flex-direction:column;}
  .service-row{
    display:grid; grid-template-columns:80px 1fr 1fr; gap:40px;
    padding:44px 0; border-bottom:1px solid var(--line);
    align-items:start;
  }
  .service-row:last-child{border-bottom:none;}
  .service-row .idx{font-family:var(--serif); font-size:15px; color:var(--violet-bright); padding-top:4px;}
  .service-row h3{font-size:24px; margin-bottom:12px;}
  .service-row .tags{display:flex; gap:8px; flex-wrap:wrap; margin-top:16px;}
  .tag{font-family:var(--mono); font-size:11px; color:var(--violet-soft); border:1px solid var(--line); padding:4px 10px; border-radius:100px; background: rgba(157, 78, 223, 0.1);}
  @media(max-width:760px){.service-row{grid-template-columns:1fr; gap:12px;}}

  /* ===== TABS: CÓMO REACCIONA PIMIENTA ===== */
  .tabs-nav{display:flex; gap:10px; flex-wrap:wrap; margin-bottom:32px;}
  .tab-btn{
    flex:1; min-width:150px;
    display:flex; align-items:center; justify-content:center; gap:10px;
    background:var(--ink-3); border:1px solid var(--line); border-radius:12px;
    padding:14px 16px; cursor:pointer; transition:all .2s;
    font-family:var(--sans); font-size:14px; font-weight:500; color:var(--text-muted);
  }
  .tab-btn .tab-ico{
    width:30px; height:30px; border-radius:50%; flex-shrink:0;
    background:rgba(157,78,223,.15);
    display:flex; align-items:center; justify-content:center; font-size:14px;
  }
  .tab-btn:hover{border-color:var(--violet-bright); color:var(--text);}
  .tab-btn.active{
    background:linear-gradient(135deg, var(--violet), #7b2fb5);
    border-color:var(--violet-bright); color:#fff;
    box-shadow:0 10px 24px rgba(157,78,223,.35);
  }
  .tab-btn.active .tab-ico{background:rgba(255,255,255,.2);}
  @media(max-width:700px){ .tabs-nav{flex-direction:column;} }

  .tab-panel{display:none;}
  .tab-panel.active{display:block; animation:panelIn .35s ease both;}
  @keyframes panelIn{ from{opacity:0; transform:translateY(10px);} to{opacity:1; transform:translateY(0);} }
  @media(prefers-reduced-motion: reduce){ .tab-panel.active{animation:none;} }

  .panel-card{
    display:grid; grid-template-columns:1fr 1fr; gap:48px; align-items:center;
    background:linear-gradient(160deg, var(--ink-2), var(--ink-3));
    border:1px solid var(--line); border-radius:20px; padding:44px;
  }
  @media(max-width:900px){ .panel-card{grid-template-columns:1fr; gap:30px; padding:28px;} }
  .panel-icon{
    width:52px; height:52px; border-radius:50%; margin-bottom:18px;
    background:rgba(157,78,223,.15);
    display:flex; align-items:center; justify-content:center; font-size:24px;
  }
  .panel-text h3{font-size:26px; margin-bottom:10px;}
  .panel-lede{font-style:italic; color:var(--violet-soft); font-size:15px; margin-bottom:22px;}
  .panel-list{list-style:none; display:flex; flex-direction:column; gap:13px; margin-bottom:28px;}
  .panel-list li{position:relative; padding-left:20px; font-size:14.5px; color:var(--text-muted); line-height:1.5;}
  .panel-list li::before{content:''; position:absolute; left:0; top:7px; width:6px; height:6px; border-radius:50%; background:var(--violet-bright);}
  .panel-mockup-label{
    font-family:var(--mono); font-size:11px; color:var(--text-muted);
    text-align:center; margin-top:14px; letter-spacing:.02em;
  }

  /* Mockup: bandeja de entrada */
  .inbox-mockup{background:var(--ink); border:1px solid var(--line); border-radius:14px; overflow:hidden;}
  .inbox-head{padding:13px 16px; border-bottom:1px solid var(--line); font-family:var(--mono); font-size:11px; color:var(--text-muted); display:flex; justify-content:space-between; align-items:center;}
  .inbox-head .live{color:#7ee787; display:flex; align-items:center; gap:5px;}
  .inbox-head .live::before{content:''; width:6px; height:6px; border-radius:50%; background:#7ee787; box-shadow:0 0 8px #7ee787;}
  .inbox-row{display:flex; gap:11px; align-items:center; padding:12px 16px; border-bottom:1px solid var(--line);}
  .inbox-row:last-child{border-bottom:none;}
  .inbox-avatar{width:32px; height:32px; border-radius:50%; flex-shrink:0; background:linear-gradient(135deg, var(--violet), var(--mint)); display:flex; align-items:center; justify-content:center; font-size:13px;}
  .inbox-meta{flex:1; min-width:0;}
  .inbox-name{font-size:13px; font-weight:600; color:var(--text);}
  .inbox-preview{font-size:12px; color:var(--text-muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;}
  .inbox-badge{background:var(--violet-bright); color:#08060D; font-size:10px; font-weight:700; border-radius:50%; width:18px; height:18px; flex-shrink:0; display:flex; align-items:center; justify-content:center;}

  /* Mockup: flujo de presupuesto */
  .quote-flow-mockup{display:flex; flex-direction:column; gap:12px;}
  .flow-step{background:var(--ink); border:1px solid var(--line); border-radius:12px; padding:13px 16px; display:flex; gap:12px; align-items:flex-start;}
  .flow-step .fnum{font-family:var(--mono); font-size:11px; color:var(--violet-bright); flex-shrink:0; margin-top:2px;}
  .flow-step strong{display:block; font-size:13.5px; color:var(--text); margin-bottom:2px;}
  .flow-step span{font-size:12px; color:var(--text-muted);}
  .flow-sheet{background:var(--ink); border:1px solid var(--line); border-radius:10px; padding:12px 14px; font-family:var(--mono); font-size:11px; color:var(--text-muted);}
  .flow-sheet .row{display:flex; justify-content:space-between; padding:3px 0;}
  .flow-sheet .row.total{border-top:1px solid var(--line); margin-top:6px; padding-top:8px; color:var(--violet-bright); font-weight:600;}

  /* Mockup: workflow automatización */
