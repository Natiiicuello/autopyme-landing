  .workflow-stat .n{font-family:var(--serif); font-size:22px; color:var(--violet-bright); font-weight:600;}
  .workflow-stat .l{font-family:var(--mono); font-size:9px; color:var(--text-muted); text-transform:uppercase; letter-spacing:.05em; margin-top:2px;}

  /* ===== EVIDENCIA: SLACK + SHEETS EN VIVO ===== */
  .evidence-grid{display:grid; grid-template-columns:1fr 1fr; gap:28px; align-items:start;}
  @media(max-width:860px){ .evidence-grid{grid-template-columns:1fr;} }
  .evidence-card{background:var(--ink-2); border:1px solid var(--line); border-radius:16px; overflow:hidden;}
  .evidence-caption{font-family:var(--mono); font-size:11px; color:var(--text-muted); text-align:center; margin-top:12px;}

  .slack-head{
    padding:13px 16px; border-bottom:1px solid var(--line);
    display:flex; justify-content:space-between; align-items:center;
    font-family:var(--sans); font-size:13px; font-weight:600; color:var(--text);
  }
  .slack-badge{background:#1264a3; color:#fff; font-size:10px; font-weight:600; padding:4px 10px; border-radius:12px; font-family:var(--sans);}
  .slack-msg{padding:13px 16px; border-bottom:1px solid var(--line); font-size:12.5px;}
  .slack-msg:last-child{border-bottom:none;}
  .slack-msg .who{color:var(--violet-bright); font-weight:600; display:flex; align-items:center; gap:6px; margin-bottom:7px; font-size:12.5px;}
  .slack-msg ul{list-style:none; display:flex; flex-direction:column; gap:4px;}
  .slack-msg li{color:var(--text-muted); font-size:12px;}
  .slack-msg li strong{color:var(--text); font-weight:600;}

  .sheet-table{width:100%; border-collapse:collapse; font-family:var(--mono); font-size:10.5px;}
  .sheet-table th{text-align:left; color:var(--text-muted); font-weight:500; padding:9px 12px; border-bottom:1px solid var(--line); background:var(--ink-3); white-space:nowrap;}
  .sheet-table td{padding:9px 12px; border-bottom:1px solid var(--line); color:var(--text-muted); max-width:130px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;}
  .sheet-table tr:last-child td{border-bottom:none;}
  .sheet-table td.fecha{color:var(--violet-soft);}

  .prompt-card{
    background:var(--ink); border:1px solid var(--line); border-radius:14px;
    padding:24px 28px; margin-top:28px;
  }
  .prompt-card .ph{
    font-family:var(--sans); font-size:12.5px; color:var(--violet-bright);
    display:flex; align-items:center; gap:8px; margin-bottom:16px;
    padding-bottom:14px; border-bottom:1px solid var(--line);
  }
  .prompt-card pre{
    font-family:var(--mono); font-size:12.5px; line-height:1.8; color:var(--text-muted);
    white-space:pre-wrap; margin:0;
  }
  .prompt-card pre strong{color:var(--text); font-weight:600;}
  .prompt-card pre .h{color:var(--mint); display:block; margin-bottom:8px;}

  /* ===== QUOTE DEMO ===== */
  .quote-demo{
    display:grid; grid-template-columns:1fr 1fr; gap:24px;
    background:var(--ink-2); border:1px solid var(--line); border-radius:18px;
    padding:28px; box-shadow:0 20px 50px rgba(0,0,0,0.5);
  }
  @media(max-width:820px){.quote-demo{grid-template-columns:1fr;}}
  .quote-col{display:flex; flex-direction:column;}
  .quote-label{font-family:var(--mono); font-size:11.5px; color:var(--text-muted); text-transform:uppercase; letter-spacing:.08em; margin-bottom:10px;}
  #quoteInput{
    background:var(--ink); border:1px solid var(--line); border-radius:10px;
    color:var(--text); font-family:var(--mono); font-size:13.5px; padding:16px;
    min-height:150px; resize:vertical; outline:none;
  }
  #quoteInput:focus{border-color:var(--violet-bright);}
  .quote-meta{display:flex; justify-content:space-between; font-family:var(--mono); font-size:11px; color:var(--text-muted); margin:10px 0 16px;}
  .quote-panel{
    background:var(--ink); border:1px solid var(--line); border-radius:10px;
    padding:20px; min-height:220px; display:flex; flex-direction:column; justify-content:center;
  }
  .quote-steps{display:flex; flex-direction:column; gap:12px;}
  .quote-step{display:flex; align-items:center; gap:10px; font-size:13.5px; color:var(--text-muted);}
  .quote-step .ico{width:16px; height:16px; flex-shrink:0; border-radius:50%; border:2px solid var(--line); display:flex; align-items:center; justify-content:center; font-size:10px;}
  .quote-step.done{color:var(--text);}
  .quote-step.done .ico{background:var(--violet); border-color:var(--violet); color:#fff;}
  .quote-step.active .ico{border-color:var(--violet-bright); animation:pulse 1s infinite;}
  .quote-result-head{font-family:var(--mono); font-size:11px; color:var(--violet-bright); text-transform:uppercase; letter-spacing:.08em; margin-bottom:14px;}
  .quote-line{display:flex; justify-content:space-between; gap:10px; font-size:13.5px; padding:7px 0; border-bottom:1px dashed var(--line);}
  .quote-line .qname{color:var(--text);}
  .quote-line .qunit{color:var(--text-muted); font-family:var(--mono); font-size:11.5px; display:block;}
  .quote-line .qamt{font-family:var(--mono); color:var(--text); white-space:nowrap;}
  .quote-sub{display:flex; justify-content:space-between; font-size:13px; color:var(--text-muted); padding:8px 0;}
  .quote-total{display:flex; justify-content:space-between; align-items:baseline; padding-top:14px; margin-top:6px; border-top:1px solid var(--line);}
  .quote-total .k{font-weight:600; font-size:14px;}
  .quote-total .v{font-family:var(--serif); font-size:28px; color:var(--violet-soft); text-shadow:0 0 15px rgba(224,170,255,0.3);}
  .quote-note{font-family:var(--mono); font-size:10.5px; color:var(--text-muted); margin-top:10px;}
  .quote-actions{display:flex; gap:10px; margin-top:18px; flex-wrap:wrap;}
  .quote-actions a{
    flex:1; text-align:center; font-size:13px; font-weight:600; padding:11px 14px; border-radius:8px;
    font-family:var(--sans);
  }
  .qa-wa{background:rgba(37,211,102,0.15); color:#3ddc7e; border:1px solid rgba(61,220,126,0.35);}
  .qa-mail{background:rgba(157,78,223,0.15); color:var(--violet-bright); border:1px solid var(--line);}

  /* ===== PROCESS ===== */
  .process{display:grid; grid-template-columns:repeat(4,1fr); gap:24px;}
  .step{position:relative; padding-top:26px;}
  .step::before{
    content:attr(data-n);
    font-family:var(--serif); font-size:15px; color:#ffffff;
    background:var(--violet);
    box-shadow: 0 0 12px var(--violet);
    width:34px; height:34px; border-radius:50%;
    display:flex; align-items:center; justify-content:center;
    margin-bottom:18px;
  }
  .step h3{font-size:16.5px; margin-bottom:8px;}
  .step p{font-size:14px;}
  .step-connector{
    position:absolute; top:17px; left:34px; right:-24px; height:1px; background:var(--line);
  }
  .step:last-child .step-connector{display:none;}
  @media(max-width:860px){.process{grid-template-columns:1fr 1fr;} .step-connector{display:none;}}
  @media(max-width:520px){.process{grid-template-columns:1fr;}}

  /* ===== STATS BAND ===== */
  .stats-band{
    background:var(--ink-2);
    border:1px solid var(--line); border-radius:20px;
    display:grid; grid-template-columns:repeat(4,1fr);
    padding:48px 20px;
    box-shadow: 0 0 30px rgba(157, 78, 223, 0.1);
  }
  .stat{text-align:center; border-right:1px solid var(--line);}
  .stat:last-child{border-right:none;}
  .stat .big{font-family:var(--serif); font-size:clamp(30px,3.6vw,42px); color:var(--violet-soft); text-shadow: 0 0 15px rgba(224, 170, 255, 0.3);}
  .stat .cap{font-family:var(--mono); font-size:12px; color:var(--text-muted); margin-top:6px;}
  @media(max-width:760px){.stats-band{grid-template-columns:1fr 1fr; gap:28px 0;} .stat{border-right:none; border-bottom:1px solid var(--line); padding-bottom:20px;} .stat:nth-child(2n){border-right:none;}}

  /* ===== CTA & QR ===== */
  .cta-section{
    background:linear-gradient(160deg, var(--ink-3), var(--ink-2));
    border: 1px solid var(--line);
    border-radius:24px; margin:0 24px;
    padding:80px 40px;
    text-align:center;
    position:relative;
    overflow:hidden;
    box-shadow: 0 0 50px rgba(157, 78, 223, 0.2);
  }
  .cta-section::after{
    content:''; position:absolute; inset:0;
    background:radial-gradient(600px 350px at 50% 0%, rgba(157, 78, 223, 0.3), transparent 70%);
  }
  .cta-section h2{max-width:560px; margin:0 auto 18px;}
  .cta-section p{max-width:520px; margin:0 auto 34px;}
  .cta-actions{display:flex; justify-content:center; align-items:center; flex-direction:column; gap:24px; position:relative; z-index:2;}
  
  /* ESTILOS DEL CÓDIGO QR Y MÓDULO PC */
  .qr-card {
    background: rgba(16, 12, 27, 0.8);
    border: 1px solid var(--violet);
    border-radius: 20px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    max-width: 320px;
  }
  .qr-box {
    background: #ffffff;
    padding: 12px;
    border-radius: 12px;
    box-shadow: 0 0 20px rgba(199, 125, 255, 0.3);
  }
  .qr-box img {
    width: 180px;
    height: 180px;
  }
  .qr-label {
    color: var(--violet-bright);
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 500;
    margin-top: 14px;
  }
  .cta-note{margin-top:22px; font-family:var(--mono); font-size:12px;}

  footer{padding:56px 24px 32px; border-top:1px solid var(--line); background: var(--ink);}
  footer .wrap{display:flex; justify-content:space-between; flex-wrap:wrap; gap:24px;}
  footer .fcol h4{font-family:var(--mono); font-size:11px; text-transform:uppercase; letter-spacing:.1em; color:var(--text-muted); margin-bottom:14px;}
  footer .fcol a{display:block; font-size:14px; color:var(--text); margin-bottom:8px; opacity:.85;}
  footer .fcol a:hover{opacity:1; color:var(--violet-bright);}
  footer .bottom{margin-top:48px; padding-top:24px; border-top:1px solid var(--line); font-family:var(--mono); font-size:11.5px; color:var(--text-muted); display:flex; justify-content:space-between; flex-wrap:wrap; gap:10px;}

  @media (prefers-reduced-motion: reduce){
    html{scroll-behavior:auto;}
    .ticker-track{animation:none;}
    .panel-head .live::before{animation:none;}
  }

  ::selection{background:var(--violet); color:#ffffff;}

  /* ===== ROI CALCULATOR (estilo violeta de la web) ===== */
  .roi-grid{display:grid; grid-template-columns:1fr 1fr; gap:40px; align-items:start;}
  @media(max-width:860px){.roi-grid{grid-template-columns:1fr;}}
  .roi-field{margin-bottom:26px;}
  .roi-field label{display:block; font-family:var(--mono); font-size:12.5px; color:var(--text-muted); margin-bottom:10px;}
  .roi-row{display:flex; align-items:center; gap:14px;}
  .roi-row input[type=range]{-webkit-appearance:none; flex:1; height:3px; background:var(--line); border-radius:2px; outline:none;}
  .roi-row input[type=range]::-webkit-slider-thumb{-webkit-appearance:none; width:16px; height:16px; border-radius:50%; background:var(--violet-bright); box-shadow:0 0 10px var(--violet-bright); cursor:pointer; border:2px solid var(--ink);}
  .roi-val{font-family:var(--mono); color:var(--violet-bright); font-weight:700; min-width:90px; text-align:right; font-size:15px;}

  .ticket{
    background:linear-gradient(180deg, var(--ink-2), var(--ink-3));
    border:1px solid var(--violet); border-radius:18px;
    color:var(--text); position:relative; padding:32px 28px 36px;
    box-shadow:0 22px 44px -18px rgba(0,0,0,0.7), 0 0 30px rgba(157,78,223,0.15);
  }
  .ticket-head{text-align:center; border-bottom:1px solid var(--line); padding-bottom:16px; margin-bottom:18px;}
  .ticket-head .t1{font-family:var(--mono); font-weight:700; letter-spacing:0.06em; font-size:14px; color:var(--violet-bright);}
  .ticket-head .t2{font-family:var(--mono); font-size:11px; color:var(--text-muted); margin-top:6px; text-transform:uppercase; letter-spacing:.08em;}
  .ticket-row{display:flex; justify-content:space-between; font-size:14px; padding:10px 0; border-bottom:1px solid var(--line);}
  .ticket-row .k{color:var(--text-muted);}
  .ticket-row .v{font-family:var(--mono); font-weight:600; color:var(--text);}
  .ticket-total{margin-top:18px; padding-top:16px; border-top:1px solid var(--line); display:flex; justify-content:space-between; align-items:baseline;}
  .ticket-total .k{font-family:var(--sans); font-size:14px; font-weight:600;}
  .ticket-total .v{font-family:var(--serif); font-size:32px; color:var(--violet-soft); text-shadow:0 0 15px rgba(224,170,255,0.35);}
  .ticket-foot{margin-top:18px; font-family:var(--mono); font-size:10.5px; color:var(--text-muted); text-align:center;}

  /* ===== SECTOR GRID ===== */
  .sector-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:16px;}
  @media(max-width:860px){.sector-grid{grid-template-columns:repeat(2,1fr);}}
  .sector-card{
    background:var(--ink-2); border:1px solid var(--line); border-radius:12px;
    padding:18px 16px; font-size:14px; font-weight:500; color:var(--text);
    display:flex; align-items:center; gap:12px;
    transition:border-color .2s ease, transform .2s ease;
  }
  .sector-card:hover{border-color:var(--violet-bright); transform:translateY(-2px);}
  .sector-ico{
    width:34px; height:34px; border-radius:9px; background:rgba(157,78,223,0.15);
    display:flex; align-items:center; justify-content:center; font-size:16px; flex-shrink:0;
  }

  /* ===== FAQ ACCORDION ===== */
  .faq-list{max-width:760px; margin:0 auto; display:flex; flex-direction:column; gap:10px;}
  .faq-item{background:var(--ink-2); border:1px solid var(--line); border-radius:12px; overflow:hidden;}
  .faq-q{
    width:100%; text-align:left; background:none; border:none; color:var(--text);
    font-family:var(--sans); font-size:14.5px; font-weight:500; padding:18px 20px;
    display:flex; justify-content:space-between; align-items:center; gap:10px; cursor:pointer;
  }
  .faq-arrow{color:var(--violet-bright); transition:transform .2s ease; flex-shrink:0;}
  .faq-item.open .faq-arrow{transform:rotate(180deg);}
  .faq-a{max-height:0; overflow:hidden; transition:max-height .25s ease;}
  .faq-a p{padding:0 20px 18px; font-size:14px;}
  .faq-item.open .faq-a{max-height:200px;}
</style>
</head>
