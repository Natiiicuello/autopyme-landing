<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AutoPYME · Agente Pimienta 100% CoderCup Edition</title>
  <style>
    :root {
      --bg-main: #121214;
      --bg-card: #1e1e24;
      --bg-inner: #2a2a32;
      --primary: #ff5722;
      --primary-hover: #e64a19;
      --text: #ffffff;
      --text-muted: #a0a0ab;
      --border: #33333d;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: var(--bg-main);
      color: var(--text);
      margin: 0;
      padding: 20px;
      display: flex;
      justify-content: center;
    }

    .app-container {
      max-width: 850px;
      width: 100%;
      background: var(--bg-card);
      border-radius: 16px;
      padding: 28px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      border: 1px solid var(--border);
    }

    .header {
      text-align: center;
      margin-bottom: 24px;
    }

    .header h1 {
      margin: 0 0 8px 0;
      font-size: 2rem;
      color: var(--text);
    }

    .header p {
      color: var(--text-muted);
      margin: 0;
      font-size: 0.95rem;
    }

    /* Badges & Métrica de impacto */
    .metric-badge {
      display: inline-block;
      background: rgba(255, 87, 34, 0.15);
      color: var(--primary);
      border: 1px solid var(--primary);
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 0.85rem;
      font-weight: bold;
      margin-top: 10px;
    }

    /* Presets */
    .presets-title {
      font-size: 0.9rem;
      color: var(--text-muted);
      margin-bottom: 8px;
    }

    .presets-grid {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 16px;
    }

    .btn-preset {
      background: var(--bg-inner);
      color: var(--text);
      border: 1px solid var(--border);
      padding: 8px 14px;
      border-radius: 8px;
      cursor: pointer;
      font-size: 0.85rem;
      transition: all 0.2s ease;
    }

    .btn-preset:hover {
      border-color: var(--primary);
      background: rgba(255, 87, 34, 0.1);
      transform: translateY(-1px);
    }

    /* Formulario */
    textarea {
      width: 100%;
      height: 90px;
      background: var(--bg-main);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 12px;
      box-sizing: border-box;
      resize: none;
      font-size: 0.95rem;
    }

    textarea:focus {
      outline: none;
      border-color: var(--primary);
    }

    .btn-main {
      background: var(--primary);
      color: var(--text);
      border: none;
      padding: 14px 20px;
      border-radius: 10px;
      font-weight: bold;
      font-size: 1rem;
      cursor: pointer;
      margin-top: 12px;
      width: 100%;
      transition: all 0.2s ease;
    }

    .btn-main:hover {
      background: var(--primary-hover);
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(255, 87, 34, 0.3);
    }

    /* Output & Feedback */
    .demo-output {
      margin-top: 20px;
      background: var(--bg-main);
      padding: 18px;
      border-radius: 10px;
      border: 1px solid var(--border);
    }

    .hidden {
      display: none !important;
    }

    .spinner {
      width: 28px;
      height: 28px;
      border: 3px solid rgba(255, 255, 255, 0.1);
      border-radius: 50%;
      border-top-color: var(--primary);
      animation: spin 0.8s linear infinite;
      margin: 0 auto 12px auto;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* Tracker visual en tiempo real */
    .workflow-tracker {
      margin-top: 20px;
      padding-top: 16px;
      border-top: 1px dashed var(--border);
    }

    .workflow-tracker h4 {
      margin: 0 0 12px 0;
      font-size: 0.85rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .tracker-steps {
      display: flex;
      justify-content: space-between;
      gap: 8px;
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .step {
      font-size: 0.75rem;
      background: var(--bg-inner);
      padding: 6px 10px;
      border-radius: 6px;
      color: var(--text-muted);
      border: 1px solid transparent;
      flex: 1;
      text-align: center;
      transition: all 0.3s ease;
    }

    .step.active {
      border-color: var(--primary);
      color: var(--text);
      font-weight: bold;
      background: rgba(255, 87, 34, 0.1);
    }

    /* Transparencia OCFE */
    .btn-ocfe {
      background: transparent;
      border: 1px solid var(--primary);
      color: var(--primary);
      padding: 10px;
      border-radius: 10px;
      cursor: pointer;
      margin-top: 24px;
      width: 100%;
      font-weight: bold;
      transition: all 0.2s ease;
    }

    .btn-ocfe:hover {
      background: rgba(255, 87, 34, 0.1);
    }

    .ocfe-modal {
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(0, 0, 0, 0.8);
      display: flex; align-items: center; justify-content: center;
      z-index: 1000;
    }

    .ocfe-content {
      background: var(--bg-card);
      color: var(--text);
      padding: 24px;
      border-radius: 12px;
      max-width: 550px;
      width: 90%;
      position: relative;
      border: 1px solid var(--border);
    }

    .ocfe-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-top: 16px;
    }

    .ocfe-card {
      background: var(--bg-inner);
      padding: 12px;
      border-radius: 8px;
      border-left: 3px solid var(--primary);
      font-size: 0.85rem;
    }

    .close-btn {
      position: absolute;
      top: 12px; right: 16px;
      font-size: 24px;
      cursor: pointer;
      color: var(--text-muted);
    }
  </style>
</head>
<body>

  <div class="app-container">
    <div class="header">
      <h1>🌶️ Agente Pimienta (AutoPYME)</h1>
      <p>Cotizaciones automáticas en 24/7 para PYMEs Argentinas</p>
      <div class="metric-badge">⚡ Recuperación del 60% de leads fuera de horario comercial</div>
    </div>
    
    <!-- Presets -->
    <div class="presets-title">⚡ Probar un escenario real de PYME:</div>
    <div class="presets-grid">
      <button class="btn-preset" onclick="cargarPreset('pedido')">📦 Pedido Mayorista ($ARS)</button>
      <button class="btn-preset" onclick="cargarPreset('horario')">🌙 Consulta 23hs (Sin stock)</button>
      <button class="btn-preset" onclick="cargarPreset('ambiguo')">❓ Consulta con Jerga Local</button>
    </div>

    <!-- Entrada -->
    <textarea id="demoInput" placeholder="Escribí una consulta en lenguaje natural o seleccioná un escenario rápido..."></textarea>
    
    <button class="btn-main" onclick="generarPresupuesto()">Generar Presupuesto con IA</button>

    <!-- Respuesta -->
    <div id="demoOutput" class="demo-output hidden">
      <div id="loadingState" class="hidden">
        <div class="spinner"></div>
        <p style="text-align: center; margin: 0; font-size: 0.9rem; color: var(--text-muted);">
          Consultando catálogo RAG y calculando IVA...
        </p>
      </div>
      
      <div id="resultContent"></div>
      
      <button id="btnCopy" class="btn-main hidden" style="margin-top: 12px;" onclick="copiarPresupuesto()">
        📋 Copiar para WhatsApp
      </button>

      <!-- Tracker de Automatización -->
      <div id="workflowTracker" class="workflow-tracker hidden">
        <h4>⚙️ Detrás de escena (Flujo Make/n8n):</h4>
        <ul class="tracker-steps">
          <li id="step1" class="step">1. Webhook</li>
          <li id="step2" class="step">2. Prompt OCFE</li>
          <li id="step3" class="step">3. RAG Catálogo</li>
          <li id="step4" class="step">4. Google Sheets</li>
        </ul>
      </div>
    </div>

    <!-- Transparencia de IA -->
    <button class="btn-ocfe" onclick="toggleOCFEModal()">🧠 Ver Cerebro de Pimienta (Ingeniería de Prompts OCFE)</button>
  </div>

  <!-- Modal OCFE -->
  <div id="ocfeModal" class="ocfe-modal hidden">
    <div class="ocfe-content">
      <span class="close-btn" onclick="toggleOCFEModal()">&times;</span>
      <h3 style="margin-top:0;">Arquitectura Prompt OCFE</h3>
      <p style="font-size: 0.85rem; color: var(--text-muted);">Garantiza cero alucinaciones y atención con modismos locales:</p>
      
      <div class="ocfe-grid">
        <div class="ocfe-card">
          <strong>[O] Objetivos</strong>
          <p style="margin: 4px 0 0 0;">Calificar lead, cotizar en $ARS + IVA y registrar en Google Sheets automáticamente.</p>
        </div>
        <div class="ocfe-card">
          <strong>[C] Contexto</strong>
          <p style="margin: 4px 0 0 0;">PYMEs en Argentina. Tono rioplatense, eficiente y profesional. Servicio 24/7.</p>
        </div>
        <div class="ocfe-card">
          <strong>[F] Formato</strong>
          <p style="margin: 4px 0 0 0;">Desglose de productos, total final y CTA claro para cerrar por WhatsApp/Telegram.</p>
        </div>
        <div class="ocfe-card">
          <strong>[E] Excepciones</strong>
          <p style="margin: 4px 0 0 0;">Si el producto no está en catálogo, NO inventar. Derivar a asesor humano vía Slack.</p>
        </div>
      </div>
    </div>
  </div>

  <script>
    const presets = {
      pedido: "Hola! Necesito presupuesto por 15 cajas de aceite de girasol y 8 kg de yerba mate para enviar a Rosario.",
      horario: "Buenas noches! ¿Tienen fardos de harina disponibles para entregar mañana a primera hora?",
      ambiguo: "Che, ¿cuánto me saldrían 20 packs de yerba con IVA y envío?"
    };

    function cargarPreset(tipo) {
      document.getElementById('demoInput').value = presets[tipo];
      generarPresupuesto();
    }

    function generarPresupuesto() {
      const input = document.getElementById('demoInput').value.trim();
      const outputContainer = document.getElementById('demoOutput');
      const loadingState = document.getElementById('loadingState');
      const resultContent = document.getElementById('resultContent');
      const btnCopy = document.getElementById('btnCopy');
      const workflowTracker = document.getElementById('workflowTracker');

      if (!input) {
        alert("Por favor ingresá un pedido o seleccioná un escenario de prueba.");
        return;
      }

      outputContainer.classList.remove('hidden');
      loadingState.classList.remove('hidden');
      resultContent.innerHTML = '';
      btnCopy.classList.add('hidden');
      workflowTracker.classList.add('hidden');

      // Animación secuencial del tracker para mostrar ejecución real
      setTimeout(() => {
        loadingState.classList.add('hidden');
        workflowTracker.classList.remove('hidden');
        
        // Simulación de respuesta estructurada y rioplatense
        resultContent.innerHTML = `
          <strong>🌶️ Pimienta respondió:</strong><br><br>
          ¡Hola! Te armé la cotización actualizada con los precios en $ARS:<br><br>
          • 15x Aceite Girasol 900ml: $27.750<br>
          • 8x Yerba Mate 1kg: $27.200<br>
          ------------------------------<br>
          <strong>Total final (IVA incl.): $66.539 ARS</strong><br><br>
          ✅ <em>Esta cotización ya fue registrada automáticamente en Google Sheets.</em>
        `;
        
        btnCopy.classList.remove('hidden');
        animarTracker();
      }, 1400);
    }

    function animarTracker() {
      const steps = ['step1', 'step2', 'step3', 'step4'];
      steps.forEach(s => document.getElementById(s).classList.remove('active'));
      
      steps.forEach((stepId, index) => {
        setTimeout(() => {
          document.getElementById(stepId).classList.add('active');
        }, index * 250);
      });
    }

    function copiarPresupuesto() {
      const texto = document.getElementById('resultContent').innerText;
      navigator.clipboard.writeText(texto).then(() => {
        const btn = document.getElementById('btnCopy');
        btn.innerText = '✅ ¡Copiado!';
        setTimeout(() => { btn.innerText = '📋 Copiar para WhatsApp'; }, 2000);
      });
    }

    function toggleOCFEModal() {
      document.getElementById('ocfeModal').classList.toggle('hidden');
    }
  </script>
</body>
</html>
