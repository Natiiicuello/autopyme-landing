<style>
  :root{
    --ink: #08060D;
    --ink-2: #100C1B;
    --ink-3: #181129;
    --violet: #9d4edf;
    --violet-bright: #c77dff;
    --violet-soft: #e0aaff;
    --mint: #b5179e;
    --text: #F3EEFE;
    --text-muted: #9D8ec4;
    --line: rgba(157, 78, 223, 0.18);
    --radius: 14px;
    --serif: 'Fraunces', serif;
    --sans: 'Inter', sans-serif;
    --mono: 'IBM Plex Mono', monospace;
  }

  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--ink);
    color:var(--text);
    font-family:var(--sans);
    line-height:1.5;
    overflow-x:hidden;
  }
  a{color:inherit; text-decoration:none;}
  img,svg{display:block; max-width:100%;}
  section{position:relative; padding:120px 24px;}
  .wrap{max-width:1120px; margin:0 auto;}
  .eyebrow{
    font-family:var(--mono);
    font-size:12.5px;
    letter-spacing:.14em;
    text-transform:uppercase;
    color:var(--violet-bright);
    display:flex;
    align-items:center;
    gap:10px;
    margin-bottom:18px;
  }
  .eyebrow::before{
    content:'';
    width:7px; height:7px; border-radius:50%;
    background:var(--violet-bright);
    box-shadow:0 0 10px var(--violet-bright);
  }
  h1,h2,h3{font-family:var(--serif); font-weight:600; letter-spacing:-0.01em;}
  h2{font-size:clamp(30px,4vw,44px); line-height:1.12;}
  p{color:var(--text-muted);}
  .lede{font-size:18px; max-width:620px;}

  /* ===== NAV ===== */
  nav{
    position:fixed; top:0; left:0; right:0; z-index:100;
    padding:20px 24px;
    background:rgba(8, 6, 13, 0.85);
    backdrop-filter:blur(14px);
    border-bottom:1px solid var(--line);
  }
  nav .wrap{display:flex; align-items:center; justify-content:space-between;}
  .logo{
    font-family:var(--serif); font-weight:700; font-size:21px;
    display:flex; align-items:center; gap:9px;
    letter-spacing:-0.01em;
  }
  .logo .dot{width:8px;height:8px;border-radius:50%;background:var(--violet-bright); box-shadow:0 0 12px var(--violet-bright);}
  nav ul{display:flex; gap:34px; list-style:none;}
  nav ul a{font-size:14.5px; color:var(--text-muted); transition:color .2s;}
  nav ul a:hover{color:var(--text);}

  /* ===== BOTÓN FLOTANTE ===== */
  .fab{
    position:fixed; bottom:26px; right:26px; z-index:80;
    width:60px; height:60px; border-radius:50%;
    background:linear-gradient(135deg, var(--violet), #7b2fb5);
    display:flex; align-items:center; justify-content:center;
    font-size:26px; text-decoration:none; color:#fff;
    box-shadow:0 10px 30px rgba(157,78,223,.45);
    animation:fabPulse 2.6s infinite;
    transition:transform .2s;
  }
  .fab:hover{transform:scale(1.08);}
  @keyframes fabPulse{
    0%{box-shadow:0 10px 30px rgba(157,78,223,.45), 0 0 0 0 rgba(157,78,223,.45);}
    70%{box-shadow:0 10px 30px rgba(157,78,223,.45), 0 0 0 14px rgba(157,78,223,0);}
    100%{box-shadow:0 10px 30px rgba(157,78,223,.45), 0 0 0 0 rgba(157,78,223,0);}
  }
  @media(prefers-reduced-motion: reduce){ .fab{animation:none;} }
  @media(max-width:600px){ .fab{width:52px; height:52px; font-size:21px; bottom:18px; right:18px;} }
  .nav-burger{
    display:none;
    background:none; border:1px solid var(--line); border-radius:8px;
    width:40px; height:40px;
    align-items:center; justify-content:center;
    cursor:pointer; flex-direction:column; gap:5px;
  }
  .nav-burger span{display:block; width:18px; height:2px; background:var(--text); transition:transform .2s, opacity .2s;}
  .nav-burger[aria-expanded="true"] span:nth-child(1){transform:translateY(7px) rotate(45deg);}
  .nav-burger[aria-expanded="true"] span:nth-child(2){opacity:0;}
  .nav-burger[aria-expanded="true"] span:nth-child(3){transform:translateY(-7px) rotate(-45deg);}
  @media(max-width:820px){
    .nav-burger{display:flex;}
    nav ul{
      display:flex; flex-direction:column; gap:0;
      position:fixed; top:73px; left:0; right:0;
      background:var(--ink-2);
      border-bottom:1px solid var(--line);
      max-height:0; overflow:hidden;
      transition:max-height .25s ease;
    }
    nav.menu-open ul{max-height:420px;}
    nav ul li{width:100%;}
    nav ul a{display:block; padding:16px 24px; border-top:1px solid var(--line); font-size:15.5px;}
  }

  /* ===== HERO ===== */
  .hero{
    padding-top:180px;
    min-height:88vh;
  }
  .hero::before{
    content:'';
    position:absolute; inset:0;
    background:
      radial-gradient(700px 500px at 85% 10%, rgba(157, 78, 223, 0.25), transparent 70%),
      radial-gradient(600px 450px at 5% 85%, rgba(181, 23, 158, 0.15), transparent 70%);
    pointer-events:none;
  }
  .hero h1{
    font-size:clamp(38px,5.4vw,64px);
    line-height:1.05;
    margin-bottom:22px;
  }
  .hero h1 em{
    font-style:italic; color:var(--violet-soft); font-weight:500;
    text-shadow: 0 0 20px rgba(224, 170, 255, 0.3);
  }
  .hero .lede{margin-bottom:34px; font-size:17.5px;}
  .hero-actions{display:flex; gap:14px; flex-wrap:wrap; margin-bottom:40px;}
  .btn{
    font-family:var(--sans); font-weight:600; font-size:15px;
    padding:14px 26px; border-radius:10px;
    display:inline-flex; align-items:center; gap:8px;
    transition:all .2s;
  }
  .btn-primary{
    background:linear-gradient(135deg, var(--violet) 0%, var(--mint) 100%);
    color:#ffffff;
    box-shadow: 0 4px 20px rgba(157, 78, 223, 0.4);
  }
  .btn-primary:hover{
    transform:translateY(-2px);
    box-shadow: 0 6px 25px rgba(199, 125, 255, 0.6);
  }
  .btn-ghost{border:1px solid var(--line); color:var(--text); background: rgba(16, 12, 27, 0.6);}
  .btn-ghost:hover{border-color:var(--violet-bright); background: rgba(157, 78, 223, 0.15);}

  .trust-row{display:flex; gap:28px; flex-wrap:wrap;}
  .trust-row .num{font-family:var(--serif); font-size:26px; color:var(--text); display:block;}
  .trust-row .lbl{font-size:12.5px; color:var(--text-muted); font-family:var(--mono);}

  /* Section Head */
  .sec-head{max-width:640px; margin-bottom:56px;}

  /* ===== STATS BAND (Con la mejora integrada) ===== */
  .stats-band{
    background:var(--ink-2);
    border:1px solid var(--line); border-radius:20px;
    display:grid; grid-template-columns:repeat(4,1fr);
    padding:48px 20px;
    box-shadow: 0 0 30px rgba(157, 78, 223, 0.1);
  }
  .stat{text-align:center; border-right:1px solid var(--line);}
  .stat:last-child{border-right:none;}
  .stat .big{
    font-family:var(--serif); 
    font-size:clamp(30px,3.6vw,42px); 
    color:var(--violet-soft); 
    text-shadow: 0 0 15px rgba(224, 170, 255, 0.3);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .stat-icon{
    font-size: 22px;
    margin-bottom: 6px;
    display: block;
    filter: drop-shadow(0 0 5px var(--violet-bright));
  }
  .stat .cap{font-family:var(--mono); font-size:12px; color:var(--text-muted); margin-top:6px;}
  @media(max-width:760px){.stats-band{grid-template-columns:1fr 1fr; gap:28px 0;} .stat{border-right:none; border-bottom:1px solid var(--line); padding-bottom:20px;} .stat:nth-child(2n){border-right:none;}}

  footer{padding:56px 24px 32px; border-top:1px solid var(--line); background: var(--ink);}
  footer .wrap{display:flex; justify-content:space-between; flex-wrap:wrap; gap:24px;}
  footer .fcol h4{font-family:var(--mono); font-size:11px; text-transform:uppercase; letter-spacing:.1em; color:var(--text-muted); margin-bottom:14px;}
  footer .fcol a{display:block; font-size:14px; color:var(--text); margin-bottom:8px; opacity:.85;}
  footer .fcol a:hover{opacity:1; color:var(--violet-bright);}
  footer .bottom{margin-top:48px; padding-top:24px; border-top:1px solid var(--line); font-family:var(--mono); font-size:11.5px; color:var(--text-muted); display:flex; justify-content:space-between; flex-wrap:wrap; gap:10px;}
</style>
</head>
