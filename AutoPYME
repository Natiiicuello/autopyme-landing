      <p style="max-width:260px; font-size:13.5px;">Automatización con IA para empresas que buscan escalar ventas sin multiplicar costos.</p>
    </div>
    <div class="fcol">
      <h4>Servicios</h4>
      <a href="#servicos">Atención Comercial 24/7</a>
      <a href="#servicos">Catálogo RAG & Cotización</a>
    </div>
    <div class="fcol">
      <h4>Proyecto</h4>
      <a href="#processo">Cómo funciona</a>
      <a href="#numeros">Resultados</a>
      <a href="https://web.telegram.org/k/#@Autopim_bot" target="_blank">Demo Telegram Web</a>
    </div>
  </div>
  <div class="wrap bottom">
    <span>© 2026 AutoPYME Argentina. Todos los derechos reservados.</span>
    <span>Cumplimiento Ley 25.326 de Protección de Datos Personales</span>
  </div>
</footer>

<script>
  // ===== DEMO: GENERADOR DE PRESUPUESTO =====
  const CATALOGO = [
    { key:'aceite', nombre:'Aceite de girasol 900ml', precio:1850 },
    { key:'harina', nombre:'Harina 000 x 1kg', precio:980 },
    { key:'arroz', nombre:'Arroz largo fino x 1kg', precio:1100 },
    { key:'gaseosa', nombre:'Gaseosa cola 2.25L', precio:2300 },
    { key:'agua', nombre:'Agua mineral sin gas 2L', precio:890 },
    { key:'yerba', nombre:'Yerba mate 1kg', precio:3400 },
    { key:'fideos', nombre:'Fideos tallarín x 500g', precio:1050 },
  ];
  const ZONAS = ['córdoba','cordoba','buenos aires','caba','gba','rosario','mendoza','la plata'];

  const quoteInput = document.getElementById('quoteInput');
  const quoteCount = document.getElementById('quoteCount');
  const quoteBtn = document.getElementById('quoteBtn');
  const quotePanel = document.getElementById('quotePanel');

  function updateCount(){ quoteCount.textContent = quoteInput.value.length + '/1500'; }
  quoteInput.addEventListener('input', updateCount);
  updateCount();

  function fmtARS(n){ return '$' + Math.round(n).toLocaleString('es-AR'); }

  function parsePedido(texto){
    const lineas = texto.split('\n').map(l => l.trim().toLowerCase()).filter(Boolean);
    const items = [];
    lineas.forEach(linea => {
      // Sólo toma como cantidad un número "suelto" (ej: "15 cajas"),
      // para no confundirlo con números pegados a una unidad (ej: "900ml", "1kg").
      const tokenCantidad = linea.split(/\s+/).find(t => /^\d+$/.test(t));
      const cantidad = tokenCantidad ? parseInt(tokenCantidad, 10) : 1;
      const producto = CATALOGO.find(p => linea.includes(p.key));
      if(producto){
        items.push({ nombre: producto.nombre, cantidad, precioUnit: producto.precio, importe: cantidad * producto.precio });
      }
    });
    let zona = ZONAS.find(z => texto.toLowerCase().includes(z));
    zona = zona ? zona.replace(/\b\w/g, c => c.toUpperCase()) : 'a coordinar';
    return { items, zona };
  }

  function renderSteps(){
    quotePanel.innerHTML = `
      <div class="quote-steps" id="qSteps">
        <div class="quote-step" data-s="0"><span class="ico"></span> Interpretando el pedido</div>
        <div class="quote-step" data-s="1"><span class="ico"></span> Consultando catálogo de productos</div>
        <div class="quote-step" data-s="2"><span class="ico"></span> Consultando datos del cliente</div>
        <div class="quote-step" data-s="3"><span class="ico"></span> Generando presupuesto personalizado…</div>
      </div>`;
    const steps = quotePanel.querySelectorAll('.quote-step');
    let i = 0;
    return new Promise(resolve => {
      function tick(){
        if(i > 0) steps[i-1].classList.replace('active','done');
        if(i < steps.length){
          steps[i].classList.add('active');
          i++;
          setTimeout(tick, 380);
        } else {
          setTimeout(resolve, 300);
        }
      }
      tick();
    });
  }

  function renderResultado(items, zona){
    if(items.length === 0){
      quotePanel.innerHTML = `<p style="font-size:13.5px; color:var(--text-muted);">No reconocí productos del catálogo en ese pedido. Probá mencionando, por ejemplo: aceite, harina, arroz, gaseosa, agua, yerba o fideos.</p>`;
      return;
    }
    const subtotal = items.reduce((a,it) => a + it.importe, 0);
    const iva = subtotal * 0.21;
    const total = subtotal + iva;
    const resumenTexto = items.map(it => `${it.cantidad}x ${it.nombre}`).join(', ');

    quotePanel.innerHTML = `
      <div class="quote-result-head">Presupuesto generado</div>
      ${items.map(it => `
        <div class="quote-line">
          <span><span class="qname">${it.cantidad}× ${it.nombre}</span><span class="qunit">${fmtARS(it.precioUnit)} c/u</span></span>
          <span class="qamt">${fmtARS(it.importe)}</span>
        </div>`).join('')}
      <div class="quote-sub"><span>Subtotal</span><span>${fmtARS(subtotal)}</span></div>
      <div class="quote-sub"><span>IVA (21%)</span><span>${fmtARS(iva)}</span></div>
      <div class="quote-total"><span class="k">Total</span><span class="v">${fmtARS(total)}</span></div>
      <div class="quote-note">incluye entrega en ${zona} · validez 15 días · valores ilustrativos</div>
      <div class="quote-actions">
        <a class="qa-wa" target="_blank" href="https://wa.me/?text=${encodeURIComponent('Presupuesto AutoPYME: ' + resumenTexto + '. Total: ' + fmtARS(total) + ' (IVA incl.)')}">Enviar por WhatsApp</a>
        <a class="qa-mail" href="mailto:?subject=${encodeURIComponent('Presupuesto AutoPYME')}&body=${encodeURIComponent('Presupuesto: ' + resumenTexto + '. Total: ' + fmtARS(total) + ' (IVA incl.), entrega en ' + zona + '.')}">Enviar por email</a>
      </div>`;
  }

  quoteBtn.addEventListener('click', async () => {
    const texto = quoteInput.value.trim();
    if(!texto) return;
    quoteBtn.disabled = true;
    const originalLabel = quoteBtn.textContent;
    quoteBtn.textContent = '✨ Pensando...';
    await renderSteps();
    const { items, zona } = parsePedido(texto);
    renderResultado(items, zona);
    quoteBtn.disabled = false;
    quoteBtn.textContent = originalLabel;
  });

  // ===== CALCULADORA ROI (remito) =====
  const hoursInput = document.getElementById('hoursInput');
  const costInput = document.getElementById('costInput');
  const leadsInput = document.getElementById('leadsInput');
  const hoursVal = document.getElementById('hoursVal');
  const costVal = document.getElementById('costVal');
  const leadsVal = document.getElementById('leadsVal');
  const rHoras = document.getElementById('rHoras');
  const rAhorro = document.getElementById('rAhorro');
  const rLeads = document.getElementById('rLeads');
  const rTotal = document.getElementById('rTotal');

  function updateROI(){
    const hours = Number(hoursInput.value);
    const cost = Number(costInput.value);
    const leads = Number(leadsInput.value);

    hoursVal.textContent = hours + ' hs';
    costVal.textContent = fmtARS(cost);
    leadsVal.textContent = leads;

    const AUTOMATION_RATE = 0.7;
    const monthlyHoursFreed = hours * AUTOMATION_RATE * 4.33;
    const laborSavings = monthlyHoursFreed * cost;
    const leadValue = leads * cost * 0.5;
    const total = laborSavings + leadValue;

    rHoras.textContent = monthlyHoursFreed.toFixed(0) + ' hs';
    rAhorro.textContent = fmtARS(laborSavings);
    rLeads.textContent = leads + ' (~' + fmtARS(leadValue) + ')';
    rTotal.textContent = fmtARS(total);
  }
  [hoursInput, costInput, leadsInput].forEach(el => el.addEventListener('input', updateROI));
  updateROI();

  // ===== TABS: CÓMO REACCIONA PIMIENTA =====
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.tab;
      document.querySelectorAll('.tab-btn').forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      document.getElementById('panel-' + target).classList.add('active');
    });
  });

  // ===== MENÚ MOBILE =====
  const siteNav = document.getElementById('siteNav');
  const navBurger = document.getElementById('navBurger');
  const navList = document.getElementById('navList');
  navBurger.addEventListener('click', () => {
    const isOpen = siteNav.classList.toggle('menu-open');
    navBurger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });
  navList.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      siteNav.classList.remove('menu-open');
      navBurger.setAttribute('aria-expanded', 'false');
    });
  });

  // ===== FAQ ACCORDION =====
  document.querySelectorAll('.faq-item').forEach(item => {
    const btn = item.querySelector('.faq-q');
    btn.addEventListener('click', () => {
      const wasOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i => {
        i.classList.remove('open');
        i.querySelector('.faq-q').setAttribute('aria-expanded', 'false');
      });
      if(!wasOpen){
        item.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>

